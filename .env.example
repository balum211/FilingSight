# Optional settings. Nothing here is required: the app needs no API key.
# Copy to .env to change defaults.

# --- Local answer model (runs on CPU, downloads once from Hugging Face) ---
# FS_LOCAL_MODEL=onnx-community/Qwen2.5-0.5B-Instruct   # any ONNX export of a ChatML model
# FS_LOCAL_ONNX_FILE=onnx/model_quantized.onnx           # int8, about 500 MB
# FS_MAX_NEW_TOKENS=160
# FS_LLM=local                                 # set to off for extractive answers only

# --- Retrieval settings ---
# FS_CHUNKING=semantic          # semantic | fixed
# FS_RERANKER=local             # local | cross-encoder | llm | none
# FS_TOP_K=5
# FS_MIN_CONFIDENCE=0.60        # "I don't know" gate for the local reranker
