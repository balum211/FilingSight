# Optional settings. Nothing here is required: the app needs no API key.
# Copy to .env to change defaults.

# --- Answer model (free, no API key) ---
# FS_LLM=free                                  # set to off for extractive answers only (nothing leaves the app)
# FS_LLM_URL=https://text.pollinations.ai/openai   # any OpenAI-compatible endpoint that needs no key
# FS_LLM_MODEL=openai                          # Pollinations alias for GPT-OSS 20B
# FS_LLM_TIMEOUT=45

# --- Retrieval settings ---
# FS_CHUNKING=semantic          # semantic | fixed
# FS_RERANKER=local             # local | cross-encoder | llm | none
# FS_TOP_K=5
# FS_MIN_CONFIDENCE=0.60        # "I don't know" gate for the local reranker
