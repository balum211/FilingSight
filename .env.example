# Copy to .env and fill in. Everything except the LLM key has a working default.

# --- LLM for written answers (Nebius AI Studio, OpenAI-compatible) ---
NEBIUS_API_KEY=
# Nebius endpoint. If your console shows the newer Token Factory URL, use that instead:
#   FS_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
FS_LLM_BASE_URL=https://api.studio.nebius.com/v1/
FS_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Model used by the LLM judge in eval/run_answer_eval.py (defaults to FS_LLM_MODEL)
# FS_JUDGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Or use OpenAI instead of Nebius (leave NEBIUS_API_KEY empty):
# OPENAI_API_KEY=
# FS_LLM_MODEL=gpt-4.1-mini

# --- Retrieval settings ---
# FS_CHUNKING=semantic          # semantic | fixed
# FS_RERANKER=local             # local | cross-encoder | llm | none
# FS_TOP_K=5
# FS_MIN_CONFIDENCE=0.60        # "I don't know" gate for the local reranker
