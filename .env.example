# Copy this file to .env and fill in the key there. The app reads .env, never this file.
# Do NOT put a real key in .env.example: it is committed to GitHub.
# Everything except the LLM key has a working default.

# --- LLM for written answers (Nebius Token Factory, Llama 3.3 70B, OpenAI-compatible) ---
NEBIUS_API_KEY=
# Nebius endpoint. Leave unset: the app tries Token Factory
# (https://api.tokenfactory.nebius.com/v1/) and falls back to the older
# AI Studio URL (https://api.studio.nebius.com/v1/). Set it only to force one.
# FS_LLM_BASE_URL=
FS_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Model used by the LLM judge in eval/run_answer_eval.py (defaults to FS_LLM_MODEL)
# FS_JUDGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Or use OpenAI instead of Nebius (leave NEBIUS_API_KEY empty):
# OPENAI_API_KEY=
# FS_LLM_MODEL=gpt-4.1-mini

# --- Retrieval settings ---
# FS_CHUNKING=semantic          # semantic | fixed
# FS_RERANKER=local             # local | cross-encoder | llm | none
# FS_TOP_K=5
# FS_MIN_CONFIDENCE=0.60        # "I don't know" gate for the local reranker
